[Unit]
Description=Zhihui Opportunity web sidecar (static 3210 + /opp-api,/shared-api proxy)
After=network.target zhihui-opportunity-api.service zhihui-project-api.service

[Service]
Type=simple
User=lgsj
Group=lgsj
WorkingDirectory=/opt/zhihui/runtime
EnvironmentFile=/opt/zhihui/env/opportunity-web.env
ExecStart=/home/lgsj/.nvm/versions/node/v22.23.3/bin/node /opt/zhihui/runtime/static-proxy.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
