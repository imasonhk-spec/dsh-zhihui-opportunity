# Opportunity Manager
DATABASE_URL=postgres://user:password@127.0.0.1:5432/shared_db
OPPORTUNITY_PORT=3210
INTELLIGENCE_BASE_URL=http://127.0.0.1:3220
# 由服务端读取，禁止提交真实 API key
DSH_BASE_URL=https://tokens.store/v1
