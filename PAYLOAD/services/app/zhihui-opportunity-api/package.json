{
  "name": "opportunity-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:api": "tsc -b tsconfig.json",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:web",
    "typecheck:api": "tsc -b tsconfig.json --pretty false",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx database/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.6",
    "@fastify/multipart": "^9.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
