[Unit]
Description=Zhihui Opportunity API (port 3211)
After=network.target

[Service]
Type=simple
User=lgsj
Group=lgsj
WorkingDirectory=/opt/zhihui/bussiness-manager
EnvironmentFile=/opt/zhihui/env/opportunity-api.env
ExecStart=/home/lgsj/.nvm/versions/node/v22.23.3/bin/node /opt/zhihui/bussiness-manager/node_modules/tsx/dist/cli.mjs apps/api/src/server.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
